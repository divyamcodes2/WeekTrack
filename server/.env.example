# Server Environment Variables
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/weektrack?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_in_production
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key_here  # Optional fallback — users provide their own keys in Settings
ENCRYPTION_SECRET=your_long_random_encryption_secret_here_change_in_production  # Required for AES-256-GCM encryption of user API keys at rest
